@model IEnumerable<Clientes.Models.ClienteModel>
@{
    ViewData["Title"] = "Listado de clientes";
}

<div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
    <div>
        <h1 class="h3 text-primary mb-1">Clientes registrados</h1>
        <p class="text-muted mb-0">Consulta, registro, actualización y eliminación de clientes</p>
    </div>
    <a class="btn btn-success" asp-action="Create">+ Nuevo cliente</a>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}

<div class="card shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-primary">
                    <tr>
                        <th>ID</th>
                        <th>@Html.DisplayNameFor(model => model.cedula)</th>
                        <th>@Html.DisplayNameFor(model => model.nombre)</th>
                        <th>@Html.DisplayNameFor(model => model.apellido)</th>
                        <th>@Html.DisplayNameFor(model => model.telefono)</th>
                        <th>@Html.DisplayNameFor(model => model.mail)</th>
                        <th>@Html.DisplayNameFor(model => model.ciudad)</th>
                        <th>@Html.DisplayNameFor(model => model.provincia)</th>
                        <th>@Html.DisplayNameFor(model => model.activo)</th>
                        <th>Opciones</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.id</td>
                        <td>@Html.DisplayFor(modelItem => item.cedula)</td>
                        <td>@Html.DisplayFor(modelItem => item.nombre)</td>
                        <td>@Html.DisplayFor(modelItem => item.apellido)</td>
                        <td>@Html.DisplayFor(modelItem => item.telefono)</td>
                        <td>@Html.DisplayFor(modelItem => item.mail)</td>
                        <td>@Html.DisplayFor(modelItem => item.ciudad)</td>
                        <td>@Html.DisplayFor(modelItem => item.provincia)</td>
                        <td><span class="badge @(item.activo ? "bg-success" : "bg-secondary")">@(item.activo ? "Sí" : "No")</span></td>
                        <td>
                            <div class="d-flex gap-1">
                                <a class="btn btn-sm btn-dark" asp-action="Edit" asp-route-id="@item.id">Editar</a>
                                <a class="btn btn-sm btn-secondary" asp-action="Details" asp-route-id="@item.id">Detalles</a>
                                <a class="btn btn-sm btn-warning" asp-action="Delete" asp-route-id="@item.id">Eliminar</a>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
            @if (!Model.Any())
            {
                <p class="text-center text-muted mb-0">No hay clientes registrados. Utilice "Nuevo cliente" para crear el primero.</p>
            }
        </div>
    </div>
</div>
